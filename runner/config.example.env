# Example environment file for the workflow runner.
#
# This is a TEMPLATE with placeholder values only. Copy it to
# runner/config.env (or another path passed via --env-file) and fill in real
# values there. Per phase3-workflow-spec.md's Environment and Secrets section,
# the real file must:
#   - never be committed to Git
#   - be readable only by the dedicated service user and administrators
#   - never be printed in logs
#
# NOTE: this repository does not yet have a .gitignore. Add runner/config.env
# (and any other real secrets file) to one before creating it for real.

# --- Repository ---
# Absolute path to the personal-performance-system repository root.
# If unset, the runner resolves it relative to this script's own location,
# which is normally sufficient -- set this explicitly only if the runner is
# invoked from outside its usual location (e.g. by a systemd unit with a
# different working directory).
REPO_ROOT=/home/coach/personal-performance-system

# --- Athlete ---
# IANA timezone name used to compute the athlete's local date and review
# filenames, per phase3-workflow-spec.md's Timezone section. Required.
ATHLETE_TIMEZONE=Europe/Amsterdam

# --- Claude Code invocation ---
CLAUDE_BINARY=claude
# Optional: pin a specific model alias/name (e.g. "sonnet"). Leave unset to
# use the account default.
CLAUDE_MODEL=
# Maximum seconds to allow a single workflow execution to run before the
# runner times it out and reports a failed execution.
CLAUDE_TIMEOUT_SECONDS=600
# Optional: cap API spend for a single execution (maps to --max-budget-usd).
# Leave unset for no cap.
CLAUDE_MAX_BUDGET_USD=
# Permission mode passed to `claude --permission-mode`. Automated execution
# has no human present to approve prompts, so tool access is restricted via
# CLAUDE_ALLOWED_TOOLS below instead, and bypassPermissions is used so the
# pre-approved tools do not block waiting for input that will never come.
# Review this tradeoff before production use.
CLAUDE_PERMISSION_MODE=bypassPermissions
# Comma-separated tool allowlist passed to `claude --allowedTools`. Read
# access lets Claude read governing documents and workflow definitions; the
# mcp__athletedata__* pattern is intended to allow AthleteData MCP tool calls.
# Verify the exact glob-matching behavior for MCP tool names during the
# manual testing step (phase3-workflow-spec.md Implementation Order, step 6)
# before relying on this in production.
CLAUDE_ALLOWED_TOOLS=Read,mcp__athletedata__*

# --- Locking ---
# Age in seconds after which a held workflow lock is considered stale and
# reclaimed by a later run, per runner/workflow-runner.md's Locking section.
LOCK_STALE_SECONDS=3600

# --- Logging ---
# Optional path to an operational log file. If unset, operational log lines
# go to stderr only. Must never contain secrets -- see the Logging section
# of phase3-workflow-spec.md.
RUNNER_LOG_FILE=

# --- Reserved for future phases (not yet read by workflow_runner.py) ---
# The AthleteData MCP API key is currently managed by Claude Code's own local
# MCP registration (see integration-status.md) and is not consumed directly
# by this script. Telegram delivery is not implemented yet.
ATHLETEDATA_MCP_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
